{
  "tempDir": true,
  "envs": {
    "DENO_DIR": "$PWD/deno_dir"
  },
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      // a copy of the npm packages in the lockfile is stored in node_modules
      "args": "run -A check.ts",
      "output": "check_initial.out"
    },
    {
      "args": "run -A delete_lockfile_and_cache.ts",
      "output": ""
    },
    {
      // the packages are resolved from the copy instead of the registry
      "args": "install",
      "output": "install_seeded.out"
    },
    {
      "args": "run -A check.ts",
      "output": "check_initial.out"
    },
    {
      // adding a dependency only resolves that dependency
      "args": "run -A add_dep.ts",
      "output": ""
    },
    {
      "args": "run -A delete_lockfile_and_cache.ts",
      "output": ""
    },
    {
      "args": "install",
      "output": "install_added.out"
    },
    {
      "args": "run -A check.ts",
      "output": "check_added.out"
    },
    {
      // a removed dependency is not kept from the copy
      "args": "run -A remove_dep.ts",
      "output": ""
    },
    {
      "args": "run -A delete_lockfile_and_cache.ts",
      "output": ""
    },
    {
      "args": "install",
      "output": "install_removed.out"
    },
    {
      "args": "run -A check.ts",
      "output": "check_removed.out"
    }
  ]
}
