{
  // The synthetic module `deno eval` creates lives in memory, so it must not be
  // resolved to a path inside `node_modules` where it would be treated as an
  // npm package file and loaded from disk. `node-gyp` evaluates `binding.gyp`
  // with `node -p` while cwd'd into the package being built.
  "tests": {
    "esm": {
      "args": "eval console.log(1)",
      "cwd": "node_modules/some-pkg",
      "output": "1\n"
    },
    "print": {
      "args": "eval -p 1+2",
      "cwd": "node_modules/some-pkg",
      "output": "3\n"
    },
    "cjs": {
      "args": ["eval", "console.log(typeof require('os').homedir())"],
      "cwd": "node_modules/some-pkg",
      "output": "string\n"
    },
    // the synthetic module has to stay in the cwd so that bare `require`s
    // resolve from the package being evaluated in. `binding.gyp` files rely on
    // this, e.g. `node -p "require('node-addon-api').include_dir"`.
    "require_resolves_from_cwd": {
      "args": ["eval", "console.log(require('other-pkg').name)"],
      "cwd": "node_modules/some-pkg",
      "output": "other-pkg\n"
    },
    "nested_node_modules": {
      "args": "eval console.log(1)",
      "cwd": "node_modules/.deno/some-pkg@1.0.0/node_modules/some-pkg",
      "output": "1\n"
    }
  }
}
