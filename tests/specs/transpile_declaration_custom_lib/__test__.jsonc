{
  "tempDir": true,
  "tests": {
    // A user-supplied `compilerOptions.lib` leaves deno's own bundled
    // `asset:///` declarations with unresolved references (e.g.
    // `lib.deno.ns.d.ts` referencing `node:net` and `NodeJS.Timeout`).
    // Those aren't user-editable and `deno check` doesn't report them, so
    // declaration emit must not fail on them either.
    "declaration_with_custom_lib": {
      "args": "transpile main.ts -o out.js --declaration",
      "output": "declaration_emit.out"
    },
    // ...but real errors in the user's own code must still be reported.
    "declaration_reports_user_errors": {
      "args": "transpile type_error.ts -o type_error_out.js --declaration",
      "output": "type_error.out",
      "exitCode": 1
    }
  }
}
