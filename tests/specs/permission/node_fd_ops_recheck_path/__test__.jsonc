{
  "tempDir": true,
  "tests": {
    "fstat_denied_read": {
      "args": "run --allow-read --allow-write --deny-read=secret.txt fstat.ts",
      "output": "fstat_denied.out"
    },
    "fstat_allowed_read": {
      "args": "run --allow-read --allow-write fstat.ts",
      "output": "fstat_allowed.out"
    },
    "futimes_denied_write": {
      "steps": [
        {
          "args": [
            "eval",
            "Deno.writeTextFileSync('target.txt', 'content\\n')"
          ],
          "output": ""
        },
        {
          "args": "run --allow-read --allow-write --deny-write=target.txt futimes.ts",
          "output": "futimes_denied.out"
        }
      ]
    },
    // the fd's path must be re-checked against the path it was opened with,
    // not the canonicalized one, otherwise a deny rule through a symlink (or
    // a Windows short name) doesn't match
    "fstat_denied_read_through_symlink": {
      "if": "unix",
      "steps": [
        {
          "args": [
            "eval",
            "Deno.mkdirSync('real'); Deno.writeTextFileSync('real/secret.txt', 'TOPSECRET-CONTENT\\n'); Deno.symlinkSync('real', 'link')"
          ],
          "output": ""
        },
        {
          "args": "run --allow-read --allow-write --deny-read=link/secret.txt fstat_symlink.ts",
          "output": "fstat_symlink_denied.out"
        }
      ]
    }
  }
}
