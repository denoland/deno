{
  "tests": {
    // The registry hostname is `localhost`, which matches no deny rule, but it
    // resolves to a denied address — the same bypass as a remote `import`.
    "denied_via_resolved_ip": {
      "args": "run --quiet --allow-import --deny-import=127.0.0.1,[::1] --node-modules-dir=none main.ts",
      "output": "[WILDCARD]Requires import access[WILDCARD]",
      "exitCode": 1
    },
    // The registry hostname itself is denied, so the request must not be made.
    "denied_via_hostname": {
      "args": "run --quiet --allow-import --deny-import=localhost --node-modules-dir=none main.ts",
      "output": "[WILDCARD]Requires import access[WILDCARD]",
      "exitCode": 1
    },
    // Control: the same package installs with no deny rule in place.
    "allowed_without_deny": {
      "args": "run --quiet --allow-import --node-modules-dir=none main.ts",
      "output": "function\n"
    }
  }
}
