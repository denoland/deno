{
  "tempDir": true,
  "steps": [
    {
      // A file inside a node_modules tree is CJS regardless of which config
      // the process loaded. `deno x` hits this: it runs an installed bin out
      // of its own cache while forwarding the user's cwd config.
      "args": [
        "run",
        "-A",
        "--config",
        "project/deno.json",
        "external/node_modules/@denotest/top-level-return/main.js"
      ],
      "output": "main.out"
    },
    {
      // Same file, no config forwarded.
      "args": "run -A external/node_modules/@denotest/top-level-return/main.js",
      "output": "main.out"
    }
  ]
}
