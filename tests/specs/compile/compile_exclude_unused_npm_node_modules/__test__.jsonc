{
  "tempDir": true,
  // use this so the vfs output is all in the same folder
  "canonicalizedTempDir": true,
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "if": "unix",
      "args": "compile -A --exclude-unused-npm --output out main.ts",
      "output": "compile.out"
    },
    {
      "if": "unix",
      "commandName": "./out",
      "args": [],
      "output": "main.out"
    },
    {
      "if": "windows",
      "args": "compile -A --exclude-unused-npm --output out.exe main.ts",
      "output": "compile.out"
    },
    {
      "if": "windows",
      "commandName": "./out.exe",
      "args": [],
      "output": "main.out"
    }
  ]
}
