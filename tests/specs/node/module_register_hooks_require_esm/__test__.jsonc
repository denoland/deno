{
  "tests": {
    "resolve_hook": {
      "args": "run -A main.cjs resolve",
      "output": "relative import ok\n"
    },
    "resolve_hook_reentrant": {
      "args": "run -A main.cjs resolve-reentrant",
      "output": "original\nrelative import ok\n"
    },
    "load_hook": {
      "args": "run -A main.cjs load",
      "output": "relative import ok\n"
    },
    "load_hook_reentrant": {
      "args": "run -A --no-lock --quiet load_reentrant.cjs",
      "output": "nested require ok\nrelative import ok\n",
      "timeout": 20
    },
    "load_hook_replacement": {
      "args": "run -A main.cjs replace",
      "output": "package replacement\n"
    },
    "load_hook_replacement_local": {
      "args": "run -A main.cjs replace-local",
      "output": "local replacement\n"
    },
    "load_hook_prepare_error": {
      "tempDir": true,
      "args": "run -A --lock=deno.lock --frozen prepare_error.cjs",
      "output": "[WILDCARD]Failed to prepare hook-provided ES module [WILDCARD]local.mjs: The lockfile is out of date.[WILDCARD]",
      "exitCode": 1
    }
  }
}
