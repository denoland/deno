{
  "tempDir": true,
  "envs": {
    "DENO_DIR": "$PWD/deno_dir"
  },
  "steps": [
    {
      // `deno_dir/` is a genuine npm cache written by Deno 2.8.2 (see
      // registry.json: abbreviated install manifest without the `time`
      // field, and predating the `_deno.packumentFormat` marker). Under
      // the default minimumDependencyAge policy (24h) with --cached-only,
      // this cache must be usable as-is instead of failing while trying to
      // re-fetch the full packument over the network (which --cached-only
      // forbids). The resolver already treats a missing publish timestamp
      // as acceptable.
      "args": "run --no-lock --cached-only --minimum-dependency-age=1440 main.ts",
      "output": "ok\n"
    }
  ]
}
